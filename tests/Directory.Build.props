<Project>
  <!-- Shared settings of all test projects; the repository-wide settings come first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- T-069 / T-082: the steady 0-byte rails (GC.GetAllocatedBytesForCurrentThread) flaked in ~35 % of full runs while a BACKGROUND (concurrent) GC ran; measured cause, see docs/TASKS.md T-069.
         Test projects only: the product keeps its own GC settings. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
