<Project Sdk="Microsoft.NET.Sdk">

  <!-- The HLA side as a plugin of the HROT host: the side of the gateway project plus the RPR connection. The RTI is a binding (IRtiBinding) found in
       the rti/ folder beside this plugin, one per RTI product. -->
  <ItemGroup>
    <ProjectReference Include="../../Gateways/SimNetGateway.Gateway.HrotDis/SimNetGateway.Gateway.HrotDis.csproj" />
    <ProjectReference Include="../../Transports/SimNetGateway.Transport.HlaRpr/SimNetGateway.Transport.HlaRpr.csproj" />
  </ItemGroup>

  <!-- publish keeps only our own assemblies (scripts/package-extension.sh then drops what the host or the parent plugin already holds) -->
  <Target Name="KeepOnlyOwnAssemblies" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ForeignPublishFile Include="@(ResolvedFileToPublish)" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)', '^SimNetGateway\.'))" />
      <ResolvedFileToPublish Remove="@(_ForeignPublishFile)" />
    </ItemGroup>
  </Target>

</Project>
