<Project>
  <!-- Central package management (R-053, DD-003): every package version lives here and only here;
       project files reference packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- viewer host (R-073, DD-005): a mutually compatible set - rlImgui-cs 3.2.0 depends on exactly Raylib-cs 7.0.1 and
         ImGui.NET 1.91.6.1. All three ship linux-x64 and win-x64 natives under runtimes/*/native (verified, R-012). -->
    <PackageVersion Include="Raylib-cs" Version="7.0.1" />
    <PackageVersion Include="ImGui.NET" Version="1.91.6.1" />
    <PackageVersion Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>
</Project>
